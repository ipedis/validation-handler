{
    "name": "ipedis/validation-handler",
    "description": "File validation handler",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "symfony/validator": "^6.0",
        "symfony/mime": "^6.1"
    },
    "autoload": {
        "psr-4": {
            "Ipedis\\ValidationHandler\\": "src/",
            "Ipedis\\ValidationHandler\\Test\\": "test/",
            "Ipedis\\ValidationHandler\\Demo\\": "demo/"
        }
    },
    "authors": [
        {
            "name": "Tejas",
            "email": "tejas@ipedis.com"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "pestphp/pest": "^1.21"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
