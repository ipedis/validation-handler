{
  "name": "ipedis/validation-handler",
  "description": "File validation handler",
  "type": "library",
  "require": {
    "php": "^8.1",
    "symfony/validator": "6.4.*",
    "symfony/mime": "6.4.*"
  },
  "autoload": {
    "psr-4": {
      "Ipedis\\ValidationHandler\\": "src/",
      "Ipedis\\ValidationHandler\\Test\\": "test/",
      "Ipedis\\ValidationHandler\\Demo\\": "demo/"
    }
  },
  "authors": [
    {
      "name": "Tejas",
      "email": "tejas@ipedis.com"
    }
  ],
  "minimum-stability": "stable",
  "require-dev": {
    "pestphp/pest": "^1.21",
    "symfony/var-dumper": "6.4.*"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
