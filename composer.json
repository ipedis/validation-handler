{
  "name": "ipedis/validation-handler",
  "description": "File validation handler",
  "type": "library",
  "require": {
    "php": "^8.2",
    "symfony/validator": "7.2.*",
    "symfony/mime": "7.2.*"
  },
  "autoload": {
    "psr-4": {
      "Ipedis\\ValidationHandler\\": "src/",
      "Ipedis\\ValidationHandler\\Test\\": "tests/",
      "Ipedis\\ValidationHandler\\Demo\\": "demo/"
    }
  },
  "authors": [
    {
      "name": "Tejas",
      "email": "tejas@ipedis.com"
    }
  ],
  "minimum-stability": "stable",
  "require-dev": {
    "pestphp/pest": "^3.7",
    "symfony/var-dumper": "7.2.*",
    "laravel/pint": "^1.20",
    "phpstan/phpstan": "^2.1"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
